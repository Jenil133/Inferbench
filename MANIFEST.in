include LICENSE README.md Makefile Dockerfile docker-compose.yml .dockerignore
recursive-include docs *.md
recursive-include examples *.json *.csv
recursive-include scripts *.sh
recursive-include src/inferbench/schemas *.json
prune reports
prune profiles
prune build
prune dist
prune *.egg-info
global-exclude __pycache__ *.py[cod] .DS_Store

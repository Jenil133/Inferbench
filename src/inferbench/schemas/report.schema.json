{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inferbench.local/schema/report-2.0.json",
  "title": "InferBench report",
  "type": "object",
  "required": ["schema_version", "config_fingerprint", "execution_id", "execution_dir", "mode", "synthetic", "configuration", "execution_plan", "results", "correlations", "methodology"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "config_fingerprint": {"$ref": "#/$defs/sha256"},
    "execution_id": {"type": "string", "minLength": 1},
    "execution_dir": {"type": "string", "minLength": 1},
    "mode": {"enum": ["simulate", "hardware"]},
    "synthetic": {"type": "boolean"},
    "synthetic_notice": {"type": ["string", "null"]},
    "model": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "warmup_iterations": {"type": "integer", "minimum": 1},
    "measured_trials": {"type": "integer", "minimum": 1},
    "independent_repetitions": {"type": "integer", "minimum": 1},
    "request_count": {"type": "integer", "minimum": 1},
    "environment": {"type": "object"},
    "configuration": {"type": "object"},
    "execution_plan": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/plan"}},
    "results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/result"}},
    "correlations": {"type": "array", "items": {"type": "object"}},
    "methodology": {"type": "object", "required": ["aggregation", "failed_request_policy", "request_concurrency", "throughput", "nsight_association"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableNumber": {"type": ["number", "null"]},
    "point": {
      "type": "object", "additionalProperties": false,
      "required": ["concurrency", "tensor_parallel", "precision", "affinity", "repetition"],
      "properties": {
        "concurrency": {"type": "integer", "minimum": 1},
        "tensor_parallel": {"type": "integer", "minimum": 1},
        "precision": {"enum": ["fp16", "fp8"]},
        "affinity": {"enum": ["pinned", "unpinned"]},
        "repetition": {"type": "integer", "minimum": 1}
      }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "point_id", "point"],
      "properties": {"sequence": {"type": "integer", "minimum": 1}, "point_id": {"type": "string"}, "point": {"$ref": "#/$defs/point"}}
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "sequence", "success", "started_at", "finished_at", "ttft_ms", "latency_ms", "prompt_tokens", "completion_tokens", "total_tokens", "finish_reason", "error_type", "error_message", "http_status", "response_id", "events"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1}, "sequence": {"type": "integer", "minimum": 1}, "success": {"type": "boolean"},
        "started_at": {"type": "string"}, "finished_at": {"type": "string"}, "ttft_ms": {"$ref": "#/$defs/nullableNumber"},
        "latency_ms": {"type": "number", "minimum": 0}, "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
        "completion_tokens": {"type": ["integer", "null"], "minimum": 0}, "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "finish_reason": {"type": ["string", "null"]}, "error_type": {"type": ["string", "null"]},
        "error_message": {"type": ["string", "null"]}, "http_status": {"type": ["integer", "null"]},
        "response_id": {"type": ["string", "null"]}, "events": {"type": "integer", "minimum": 0}
      }
    },
    "trial": {
      "type": "object", "additionalProperties": false,
      "required": ["trial", "repetition", "status", "concurrency", "request_count", "successful_requests", "failed_requests", "wall_time_s", "throughput_tokens_s", "ttft_p50_ms", "ttft_p99_ms", "latency_p50_ms", "latency_p99_ms", "selected_os_runtime_wait_ms", "requests"],
      "properties": {
        "trial": {"type": "integer", "minimum": 1}, "repetition": {"type": "integer", "minimum": 1},
        "status": {"enum": ["completed", "partial", "failed"]}, "concurrency": {"type": "integer", "minimum": 1},
        "request_count": {"type": "integer", "minimum": 1}, "successful_requests": {"type": "integer", "minimum": 0},
        "failed_requests": {"type": "integer", "minimum": 0}, "wall_time_s": {"type": "number", "minimum": 0},
        "throughput_tokens_s": {"$ref": "#/$defs/nullableNumber"}, "ttft_p50_ms": {"$ref": "#/$defs/nullableNumber"},
        "ttft_p99_ms": {"$ref": "#/$defs/nullableNumber"}, "latency_p50_ms": {"$ref": "#/$defs/nullableNumber"},
        "latency_p99_ms": {"$ref": "#/$defs/nullableNumber"}, "selected_os_runtime_wait_ms": {"$ref": "#/$defs/nullableNumber"},
        "requests": {"type": "array", "items": {"$ref": "#/$defs/request"}}
      }
    },
    "summary": {
      "type": "object",
      "required": ["pooled_successful_requests", "pooled_failed_requests", "pooled_ttft_samples", "pooled_latency_samples", "pooled_ttft_p50_ms", "pooled_ttft_p99_ms", "pooled_latency_p50_ms", "pooled_latency_p99_ms", "latency_p99_ms_trial_median", "latency_p99_ms_trial_iqr", "latency_p99_ms_trial_samples"]
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["point", "trials", "summary", "status", "profile_status", "profile_artifact", "profile_summary", "notes"],
      "properties": {
        "point": {"$ref": "#/$defs/point"}, "trials": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/trial"}},
        "summary": {"$ref": "#/$defs/summary"}, "status": {"enum": ["completed", "partial", "failed"]},
        "profile_status": {"enum": ["disabled", "missing_tool", "capture_requested", "parsed", "extract_failed", "missing_artifact"]},
        "profile_artifact": {"type": ["string", "null"]}, "profile_summary": {"type": ["object", "null"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "additionalProperties": false
}
